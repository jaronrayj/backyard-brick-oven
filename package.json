{
  "name": "backyard-brick-oven",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@headlessui/react": "^1.5.0",
    "@heroicons/react": "^1.0.6",
    "@iconify/icons-mdi": "^1.2.17",
    "@iconify/react": "^3.2.2",
    "@testing-library/jest-dom": "^5.16.2",
    "@testing-library/react": "^12.1.3",
    "@testing-library/user-event": "^13.5.0",
    "firebase": "^9.6.8",
    "google-map-react": "^2.1.10",
    "lodash": "^4.17.21",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-firebase-hooks": "^5.0.3",
    "react-helmet-async": "1.3.0",
    "react-medium-image-zoom": "^5.1.10",
    "react-router-dom": "^6.2.2",
    "react-scripts": "5.0.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "dev": "concurrently -n emulator,cra -c yellow,cyan \"yarn dev:emulator\" \"yarn dev:cra\"",
    "dev:emulator": "firebase emulators:start --only functions,hosting",
    "dev:cra": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "react-snap",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "reactSnap": {
    "source": "build",
    "include": [
      "/",
      "/order",
      "/inquiries"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "rules": {
      "no-unused-vars": "off"
    }
  },
  "devDependencies": {
    "autoprefixer": "^10.4.4",
    "concurrently": "8.2.2",
    "http-proxy-middleware": "2.0.6",
    "postcss": "^8.4.12",
    "react-snap": "1.23.0",
    "tailwindcss": "^3.0.24"
  }
}
