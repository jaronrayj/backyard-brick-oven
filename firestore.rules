rules_version = '2';
// Firestore rules. Deployed from this file (firebase.json); edits in the
// console are overwritten on the next deploy.
//
// `team` is a tag on each person's sign-in ("admin" or "staff"), copied by
// functions/team.js from the one team list, plannerAccess/team.
service cloud.firestore {
  match /databases/{database}/documents {
    function role() {
      return request.auth != null && request.auth.token.email_verified == true
        ? request.auth.token.get('team', '')
        : '';
    }
    function isAdmin() { return role() == 'admin'; }
    function onTeam() { return role() == 'admin' || role() == 'staff'; }

    // The team list itself. Pages read it to decide what to show; only the
    // console (or an admin tool) changes it.
    match /plannerAccess/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Dough planner. planner/ref is written by the Cloud Function.
    // Admins change the plan; the whole team can check things off (Shopping, Prep, Bring).
    match /planner/{doc} {
      allow read: if onTeam();
      allow write: if (isAdmin() && doc in ['plan', 'checks']) || (onTeam() && doc == 'checks');
    }

    // Events, quotes and their settings.
    match /events/{id} {
      allow read, write: if isAdmin();
    }
    match /eventSettings/{doc} {
      allow read, write: if isAdmin();
    }
    // Sent notifications, for the bell's "Recent notifications" (written by
    // functions/push.js).
    match /notifications/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Prices the public website shows (written by the Events > Pricing page).
    // Visitor counts (written by the countStep function), for Events > Report.
    match /siteStats/{month} {
      allow read: if isAdmin();
    }
    // /hello email sign-ups. Written only by the sendSignup function; admins
    // see them at /admin/signups.
    match /signups/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // Wedding tastings offered in quote emails. Only the functions in
    // functions/tasting.js read and write them; the /tasting page goes through those.
    match /tastings/{token} {
      allow read, write: if false;
    }
    match /publicSettings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
